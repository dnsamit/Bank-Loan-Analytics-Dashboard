	column 'Good vs Bad Loan' =
			SWITCH(
				TRUE,
				ISBLANK('Bank_loan_data'[loan_status]),
				"(Blank)",
				'Bank_loan_data'[loan_status] IN {"Charged Off"},
				"Bad Loan",
				'Bank_loan_data'[loan_status] IN {"Current",
					"Fully Paid"},
				"Good Loan",
				'Bank_loan_data'[loan_status]
			)
		lineageTag: 15ddd92b-59ae-4a32-a052-54d7d730511e
		summarizeBy: none

		extendedProperty GroupingMetadata =
				{
				  "version": 0,
