table Bank_loan_data
	lineageTag: ba56fee5-e663-4b63-9e79-19b76490ca0b

	measure 'Total Loan Application' = COUNT(Bank_loan_data[id])
		formatString: 0
		lineageTag: d2e86274-24bc-4a48-9f92-501df4182e3e

	measure 'MTD Loan Application' = CALCULATE(TOTALMTD([Total Loan Application],'Date Table'[Date]))
		formatString: 0
		lineageTag: 9a3f831c-cb18-41fa-a10f-2f33324a2010

	measure 'PMTD Loan Application' = CALCULATE([Total Loan Application],DATESMTD(DATEADD('Date Table'[Date],-1,MONTH)))
		formatString: 0
		lineageTag: eb32f6b5-b00b-4373-8151-851be3126ee7

	measure 'MoM Loan Applicaion' = ([MTD Loan Application] - [PMTD Loan Application])/[PMTD Loan Application]
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 8455a159-77cd-42b8-9756-264297c876d3

	measure 'Total Funded Amount' = SUM(Bank_loan_data[loan_amount])
		formatString: \$#,0.0;(\$#,0.0);\$#,0.0
		lineageTag: babf0d6a-89f9-4e8a-a200-aeeda867e628

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'MTD Funded Amount' = CALCULATE(TOTALMTD([Total Funded Amount],'Date Table'[Date]))
		formatString: \$#,0.0;(\$#,0.0);\$#,0.0
		lineageTag: f0573923-e277-4fb2-9bd9-8b5c77d1ae37

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'PMTD Total Funded Amount' = CALCULATE([Total Funded Amount],DATESMTD(DATEADD('Date Table'[Date],-1,MONTH)))
		formatString: 0
		lineageTag: a10c4e78-259f-4764-8070-7c66071335b8

	measure 'MoM Total Funded Amount' = ([MTD Funded Amount] -[PMTD Total Funded Amount])/[PMTD Total Funded Amount]
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 576c08ca-84bd-423d-8097-79b25ecd6f33

	measure 'Total Amount Received' = SUM(Bank_loan_data[total_payment])
		formatString: \$#,0.0;(\$#,0.0);\$#,0.0
		lineageTag: c4eeef84-d3f9-42fe-89df-689141c53586

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'MTD Total Received' = CALCULATE(TOTALMTD([Total Amount Received],'Date Table'[Date]))
		formatString: \$#,0.0;(\$#,0.0);\$#,0.0
		lineageTag: 4e4920dc-c7af-4328-8485-9234b3b36115

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'PMTD Total Received Amount' = CALCULATE([Total Amount Received], DATESMTD(DATEADD('Date Table'[Date],-1,MONTH)))
		formatString: 0
		lineageTag: 5a84e6fe-e258-4e67-a32b-84f08537c125

	measure 'MoM Total Received Amount' = ([MTD Total Received]-[PMTD Total Received Amount])/[PMTD Total Received Amount]
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: dde0cbac-57da-4108-ba19-ae3600498c51

	measure 'Avg Interest Rate' = AVERAGE(Bank_loan_data[int_rate])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: da5d068b-a78e-4753-911d-37a74e58f00f

	measure 'MTD Avg Interest Rate' = CALCULATE(TOTALMTD([Avg Interest Rate],'Date Table'[Date]))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: bfe980f0-f273-446a-b55b-bcc097cd3653

	measure 'PMTD Avg Interest Rate' = CALCULATE([Avg Interest Rate],DATESMTD(DATEADD('Date Table'[Date],-1,MONTH)))
		lineageTag: 8093fb17-0127-43c1-a382-1e7528ca8383

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Mom Avg Interest Rate' = ([MTD Avg Interest Rate]-[PMTD Avg Interest Rate])/[PMTD Avg Interest Rate]
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 2a780368-a5e1-4bc2-b788-9d5568cfce5d

	measure 'Avg DTI' = AVERAGE(Bank_loan_data[dti])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 91e67465-84c2-47c4-8d03-f215f68f9bbf

	measure 'MTD Avg DTI' = CALCULATE((TOTALMTD([Avg DTI],'Date Table'[Date])))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: caeb5986-4f77-483c-bc0c-c6a450b34283

	measure 'PMTD Avg DTI' = CALCULATE([Avg DTI],DATESMTD(DATEADD('Date Table'[Date],-1,MONTH)))
		lineageTag: 2a421e03-eadb-4e7f-9d6d-cfe8df6df4a1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'MoM Avg DTI' = ([MTD Avg DTI]-[PMTD Avg DTI])/[PMTD Avg DTI]
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: efbd7f0e-1f84-4d08-abbf-0db0e7a759cb

	measure 'Good Loan %' = (CALCULATE([Total Loan Application],Bank_loan_data[Good vs Bad Loan] = "Good Loan")) / [Total Loan Application]
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 1fa595a3-1f66-4beb-bf3c-fae34dabe7bf

	measure 'Good Loan Funded Amount' = CALCULATE([Total Funded Amount],Bank_loan_data[Good vs Bad Loan] = "Good Loan")
		formatString: \$#,0.0;(\$#,0.0);\$#,0.0
		lineageTag: 4101becb-df38-41bb-aecf-0502a21317bf

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Good Loan Received Amount' = CALCULATE([Total Amount Received],Bank_loan_data[Good vs Bad Loan] = "Good Loan")
		formatString: \$#,0.0;(\$#,0.0);\$#,0.0
		lineageTag: f59c98fa-7b33-446d-a431-8101fb0dff79

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Bad Loan %' = (CALCULATE([Total Loan Application],Bank_loan_data[Good vs Bad Loan] = "Bad Loan")) / [Total Loan Application]
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 833d8e3c-7c5a-4676-aa3e-9aeb02ea292b

	measure 'Bad Loan Application' = CALCULATE([Total Loan Application],Bank_loan_data[Good vs Bad Loan] = "Bad Loan")
		formatString: 0
		lineageTag: 0ca280ff-6e15-4892-9c4d-5bc047a0cb06

	measure 'Bad Loan Funded Amount' = CALCULATE([Total Funded Amount],Bank_loan_data[Good vs Bad Loan] = "Bad Loan")
		formatString: \$#,0.0;(\$#,0.0);\$#,0.0
		lineageTag: 615b232a-dfb6-4d42-9270-006cbbb97c3f

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Bad Loan Received Amount' = CALCULATE([Total Amount Received],Bank_loan_data[Good vs Bad Loan] = "Bad Loan")
		formatString: \$#,0.0;(\$#,0.0);\$#,0.0
		lineageTag: 3efb0ba1-a8a6-48b5-b23b-00c0e0282a1e

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

